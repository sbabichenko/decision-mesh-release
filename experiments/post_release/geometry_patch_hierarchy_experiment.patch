+struct GeometryPatchDraw {
+    double residual = 0.0;
+    double noise_variance = 0.0;
+    double base_variance = 0.0;
+};
+
+std::vector<double> geometry_patch_dijkstra(
+        int source,
+        const std::vector<std::vector<std::pair<int, double>>>& adjacency) {
+    const double inf = std::numeric_limits<double>::infinity();
+    std::vector<double> distance(adjacency.size(), inf);
+    using Entry = std::pair<double, int>;
+    std::priority_queue<Entry, std::vector<Entry>, std::greater<Entry>> queue;
+    distance[source] = 0.0;
+    queue.push({0.0, source});
+    while (!queue.empty()) {
+        const auto [current, vertex] = queue.top();
+        queue.pop();
+        if (current != distance[vertex]) continue;
+        for (const auto& [neighbor, length] : adjacency[vertex]) {
+            const double proposal = current + length;
+            if (proposal < distance[neighbor]) {
+                distance[neighbor] = proposal;
+                queue.push({proposal, neighbor});
+            }
+        }
+    }
+    return distance;
+}
+
+double estimate_geometry_patch_log_scale(
+        const std::vector<GeometryPatchDraw>& draws,
+        double parent_log_scale,
+        double log_prior_strength,
+        double minimum_scale,
+        double maximum_scale) {
+    if (draws.empty()) return parent_log_scale;
+    const double z_lo = std::log(minimum_scale);
+    const double z_hi = std::log(maximum_scale);
+    constexpr int grid_points = 181;
+    double best_z = std::clamp(parent_log_scale, z_lo, z_hi);
+    double best_objective = -std::numeric_limits<double>::infinity();
+    for (int j = 0; j < grid_points; ++j) {
+        const double z = z_lo + (z_hi - z_lo) * j / (grid_points - 1.0);
+        const double scale = std::exp(z);
+        double objective = -0.5 * log_prior_strength *
+            (z - parent_log_scale) * (z - parent_log_scale);
+        for (const GeometryPatchDraw& draw : draws) {
+            const double variance = draw.noise_variance +
+                                    scale * draw.base_variance;
+            if (!(variance > 0.0) || !std::isfinite(variance)) continue;
+            objective -= 0.5 * (std::log(variance) +
+                draw.residual * draw.residual / variance);
+        }
+        if (objective > best_objective) {
+            best_objective = objective;
+            best_z = z;
+        }
+    }
+    return best_z;
+}
