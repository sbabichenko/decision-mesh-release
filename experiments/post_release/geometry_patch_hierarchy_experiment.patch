+void DecisionMesh::recompute_geometry_patch_scales() {
+    geometry_patch_scale.clear();
+
+    const int target_leaf_size = [] {
+        const char* e = std::getenv("DMESH_GEOMETRY_PATCH_LEAF_SIZE");
+        return std::clamp(e ? std::atoi(e) : 24, 8, 128);
+    }();
+    const int minimum_draws = [] {
+        const char* e = std::getenv("DMESH_GEOMETRY_PATCH_MIN_COUNT");
+        return std::clamp(e ? std::atoi(e) : 6, 2, 64);
+    }();
+    const int maximum_level = [] {
+        const char* e = std::getenv("DMESH_GEOMETRY_PATCH_MAX_LEVEL");
+        return std::clamp(e ? std::atoi(e) : 8, 1, 20);
+    }();
+    const double log_prior_strength = [] {
+        const char* e = std::getenv("DMESH_GEOMETRY_PATCH_LOG_PRIOR");
+        const double value = e ? std::atof(e) : 10.0;
+        return (std::isfinite(value) && value >= 0.0) ? value : 10.0;
+    }();
+    const double minimum_scale = [] {
+        const char* e = std::getenv("DMESH_GEOMETRY_PATCH_MIN_SCALE");
+        const double value = e ? std::atof(e) : 0.35;
+        return (std::isfinite(value) && value > 0.0) ? value : 0.35;
+    }();
+    const double maximum_scale = [minimum_scale] {
+        const char* e = std::getenv("DMESH_GEOMETRY_PATCH_MAX_SCALE");
+        const double value = e ? std::atof(e) : 2.5;
+        return (std::isfinite(value) && value >= minimum_scale)
+            ? value : std::max(2.5, minimum_scale);
+    }();
+
+    std::vector<Vertex*> active;
+    active.reserve(vertices.size());
+    for (Vertex* vertex : vertices)
+        if (vertex != nullptr && vertex->active) active.push_back(vertex);
+    if (active.empty()) return;
+
+    std::unordered_map<Vertex*, int> active_index;
+    active_index.reserve(active.size());
+    for (int i = 0; i < static_cast<int>(active.size()); ++i)
+        active_index[active[i]] = i;
+
+    std::vector<std::vector<std::pair<int, double>>> adjacency(active.size());
+    for (Edge* edge : active_edges) {
+        if (edge == nullptr || !edge->active || edge->vertex0 == nullptr ||
+            edge->vertex1 == nullptr) continue;
+        const auto first = active_index.find(edge->vertex0);
+        const auto second = active_index.find(edge->vertex1);
+        if (first == active_index.end() || second == active_index.end()) continue;
+        double length = std::hypot(edge->vertex0->x - edge->vertex1->x,
+                                   edge->vertex0->y - edge->vertex1->y);
+        if (!(length > 0.0)) length = 1e-12;
+        adjacency[first->second].push_back({second->second, length});
+        adjacency[second->second].push_back({first->second, length});
+    }
+
+    std::vector<Vertex*> statistical;
+    for (Vertex* vertex : active) {
+        if (!vertex->free_coefficient || vertex->retired_coefficient ||
+            vertex->parent_edge == nullptr) continue;
+        statistical.push_back(vertex);
+    }
+    const int n = static_cast<int>(statistical.size());
+    if (n < minimum_draws) return;
+
+    struct PatchNode {
+        std::vector<int> members;
+        int parent = -1;
+        int level = 0;
+        int left = -1;
+        int right = -1;
+        double log_scale = 0.0;
+        int draw_count = 0;
+    };
+    std::vector<PatchNode> nodes;
+    nodes.push_back({});
+    nodes[0].members.resize(n);
+    std::iota(nodes[0].members.begin(), nodes[0].members.end(), 0);
+
+    std::function<void(int)> split_patch = [&](int node_index) {
+        PatchNode& node = nodes[node_index];
+        if (node.level >= maximum_level ||
+            static_cast<int>(node.members.size()) <= target_leaf_size) return;
+        const int seed = node.members.front();
+        const auto seed_distance = geometry_patch_dijkstra(
+            active_index.at(statistical[seed]), adjacency);
+        auto farthest_using = [&](const std::vector<double>& source_distance,
+                                  int fallback) {
+            int best = fallback;
+            double best_distance = -1.0;
+            for (int candidate : node.members) {
+                const double value = source_distance[
+                    active_index.at(statistical[candidate])];
+                if (std::isfinite(value) &&
+                    (value > best_distance + 1e-14 ||
+                     (std::fabs(value - best_distance) <= 1e-14 &&
+                      statistical[candidate]->_id < statistical[best]->_id))) {
+                    best = candidate;
+                    best_distance = value;
+                }
+            }
+            return best;
+        };
+        const int first_center = farthest_using(seed_distance, seed);
+        const auto first_distance = geometry_patch_dijkstra(
+            active_index.at(statistical[first_center]), adjacency);
+        const int second_center = farthest_using(first_distance, first_center);
+        if (first_center == second_center) return;
+        const auto second_distance = geometry_patch_dijkstra(
+            active_index.at(statistical[second_center]), adjacency);
+
+        std::vector<int> left_members, right_members;
+        left_members.reserve(node.members.size());
+        right_members.reserve(node.members.size());
+        for (int member : node.members) {
+            const int member_active = active_index.at(statistical[member]);
+            const double dl = first_distance[member_active];
+            const double dr = second_distance[member_active];
+            if (dl < dr || (std::fabs(dl - dr) <= 1e-14 &&
+                            statistical[first_center]->_id <
+                            statistical[second_center]->_id))
+                left_members.push_back(member);
+            else
+                right_members.push_back(member);
+        }
+        if (static_cast<int>(left_members.size()) < minimum_draws ||
+            static_cast<int>(right_members.size()) < minimum_draws) return;
+
+        const int child_level = node.level + 1;
+        const int left_index = static_cast<int>(nodes.size());
+        nodes.push_back({std::move(left_members), node_index, child_level});
+        const int right_index = static_cast<int>(nodes.size());
+        nodes.push_back({std::move(right_members), node_index, child_level});
+        nodes[node_index].left = left_index;
+        nodes[node_index].right = right_index;
+        split_patch(left_index);
+        split_patch(right_index);
+    };
+    split_patch(0);
+
+    std::vector<int> deepest_node(n, 0);
+    std::function<void(int)> estimate_patch = [&](int node_index) {
+        PatchNode& node = nodes[node_index];
+        const double parent_log = node.parent < 0 ? 0.0 : nodes[node.parent].log_scale;
+        std::vector<GeometryPatchDraw> draws;
+        draws.reserve(node.members.size());
+        for (int member : node.members) {
+            Vertex* vertex = statistical[member];
+            if (!vertex->gate_admitted || vertex->dormant_coefficient ||
+                !(vertex->sigma_sq > 0.0) || !(vertex->sigma_sq < 1e250)) continue;
+            const double base = tau_for_depth(vertex->depth);
+            if (!(base > 0.0) || !std::isfinite(base)) continue;
+            const double residual = vertex->height - vertex->mu_prior();
+            if (!std::isfinite(residual)) continue;
+            draws.push_back({residual, vertex->sigma_sq, base});
+        }
+        node.draw_count = static_cast<int>(draws.size());
+        if (node.parent < 0) node.log_scale = 0.0;
+        else if (node.draw_count >= minimum_draws)
+            node.log_scale = estimate_geometry_patch_log_scale(
+                draws, parent_log, log_prior_strength,
+                minimum_scale, maximum_scale);
+        else node.log_scale = parent_log;
+
+        if (node.left < 0 && node.right < 0) {
+            for (int member : node.members) deepest_node[member] = node_index;
+        } else {
+            if (node.left >= 0) estimate_patch(node.left);
+            if (node.right >= 0) estimate_patch(node.right);
+        }
+    };
+    estimate_patch(0);
+
+    double weighted_log_sum = 0.0;
+    double weight_sum = 0.0;
+    for (int member = 0; member < n; ++member) {
+        Vertex* vertex = statistical[member];
+        if (!vertex->gate_admitted || vertex->dormant_coefficient) continue;
+        weighted_log_sum += nodes[deepest_node[member]].log_scale;
+        weight_sum += 1.0;
+    }
+    const double mean_log = weight_sum > 0.0 ? weighted_log_sum / weight_sum : 0.0;
+    double min_seen = 1.0, max_seen = 1.0;
+    for (int member = 0; member < n; ++member) {
+        double scale = std::exp(nodes[deepest_node[member]].log_scale - mean_log);
+        scale = std::clamp(scale, minimum_scale, maximum_scale);
+        geometry_patch_scale[statistical[member]->_id] = scale;
+        min_seen = std::min(min_seen, scale);
+        max_seen = std::max(max_seen, scale);
+    }
+
+    int leaf_count = 0, estimated_nodes = 0;
+    for (const PatchNode& node : nodes) {
+        if (node.left < 0 && node.right < 0) ++leaf_count;
+        if (node.parent >= 0 && node.draw_count >= minimum_draws) ++estimated_nodes;
+    }
+    std::fprintf(stderr,
+        "[geometry-patch-eb] vertices %d nodes %zu leaves %d estimated %d "
+        "leaf-target %d min-draws %d log-prior %.4g scale-range %.4g..%.4g\n",
+        n, nodes.size(), leaf_count, estimated_nodes, target_leaf_size,
+        minimum_draws, log_prior_strength, min_seen, max_seen);
+
+    if (const char* path = std::getenv("DMESH_GEOMETRY_PATCH_DUMP")) {
+        if (*path) {
+            std::ofstream out(path);
+            out << "vertex_id,x,y,depth,patch_node,patch_level,patch_size,draw_count,scale\n";
+            for (int member = 0; member < n; ++member) {
+                Vertex* vertex = statistical[member];
+                const int node_index = deepest_node[member];
+                const PatchNode& node = nodes[node_index];
+                out << vertex->_id << ',' << vertex->x << ',' << vertex->y << ','
+                    << vertex->depth << ',' << node_index << ',' << node.level << ','
+                    << node.members.size() << ',' << node.draw_count << ','
+                    << geometry_patch_scale[vertex->_id] << '\n';
+            }
+        }
+    }
+}
+
+double DecisionMesh::geometry_patch_scale_for(const Vertex* vertex) const {
+    if (vertex == nullptr || geometry_patch_scale.empty()) return 1.0;
+    const auto found = geometry_patch_scale.find(vertex->_id);
+    return found == geometry_patch_scale.end() ? 1.0 : found->second;
+}
